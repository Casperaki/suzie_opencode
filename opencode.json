{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM Proxy",
      "options": {
        "baseURL": "http://host.docker.internal:4000/v1",
        "apiKey": "coding-agent-internal"
      },
      "models": {
        "qwen3.6-plus": {
          "name": "qwen3.6-plus",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "proxy/qwen3.6-plus"
    },
    "title": {
      "model": "proxy/qwen3.6-plus"
    }
  }
}
